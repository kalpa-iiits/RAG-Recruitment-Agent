# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY = "sk-..."

# Where the app stores users, resumes, analyses and job matches.
# Leave unset for the local SQLite file at backend/data/cvexpert.db.
# Amazon RDS (Postgres) — note sslmode=require, which RDS expects:
# DATABASE_URL = "postgresql://USER:PASSWORD@my-db.abcdef.ap-south-1.rds.amazonaws.com:5432/cvexpert?sslmode=require"
DATABASE_URL = ""

# --- Resume file storage (S3) ---
# Leave S3_BUCKET empty to skip file storage entirely: the app still extracts
# and analyses the text, it just keeps no copy of the original PDF.
S3_BUCKET = ""
AWS_REGION = "ap-south-1"
# Key prefix inside the bucket; objects land at <prefix>/<user id>/<uuid>.pdf
S3_PREFIX = "resumes"
# Seconds a download link stays valid.
S3_PRESIGN_EXPIRY = 900
# Only for MinIO / LocalStack. Leave empty for real S3.
S3_ENDPOINT_URL = ""
# Credentials: leave these unset in AWS and attach an IAM role to the task or
# instance instead. They are only for local testing.
# AWS_ACCESS_KEY_ID = ""
# AWS_SECRET_ACCESS_KEY = ""

# Model used for all LLM calls in agents.py
OPENAI_MODEL = "gpt-4o-mini"

# Comma-separated origins allowed to call the API (e.g. React dev servers)
CORS_ORIGINS = "http://localhost:5173,http://localhost:3000,http://www.cvexpert.in.s3-website-ap-southeast-2.amazonaws.com/,http://cvexpert.in.s3-website-ap-southeast-2.amazonaws.com/,http://www.cvexpert.in,http://cvexpert.in,https://www.cvexpert.in,https://cvexpert.in"

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET = ""

# Minutes a login token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES = 60

# Set to false to stop new sign-ups once your accounts exist
ALLOW_REGISTRATION = true
