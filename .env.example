# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY = "sk-..."

# Model used for all LLM calls in agents.py
OPENAI_MODEL = "gpt-4o-mini"

# Comma-separated origins allowed to call the API (e.g. React dev servers)
CORS_ORIGINS = "http://localhost:5173,http://localhost:3000"

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET = ""

# Minutes a login token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES = 60

# Set to false to stop new sign-ups once your accounts exist
ALLOW_REGISTRATION = true
